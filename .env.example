# Copy to .env and replace every required value before starting Compose.
ENVIRONMENT=production
PROJECT_NAME=Tahr Desk
FRONTEND_HOST=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:8000

SECRET_KEY=<generate-a-long-random-value>
FIRST_SUPERUSER=wardenn-admin@tahr.ca
FIRST_SUPERUSER_PASSWORD=<set-at-runtime>

POSTGRES_DB=tahr_desk
POSTGRES_USER=tahr_desk
POSTGRES_PASSWORD=<set-at-runtime>

# Use tahr-desk:local for a local build. Released deployments require @sha256.
TAHR_DESK_IMAGE=tahr-desk:local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
WEBHOOK_DELIVERY_ENABLED=false
